# Depuis la racine du dépôt :
# cp deployments/docker/.env.example deployments/docker/.env
# Adapter les valeurs avant de démarrer Compose.
# Les variables exportées dans le shell prévalent sur ce fichier.

# Obligatoire : chemin absolu d'un répertoire existant, accessible en lecture,
# écriture et traversée à l'UID/GID ci-dessous. Compose ne le crée pas.
SILLAGE_DATA_DIR=/home/utilisateur/.local/share/sillage

# Facultatives, mais recommandées : adapter avec id -u et id -g.
# Valeur par défaut pour chacune : 1000.
SILLAGE_UID=1000
SILLAGE_GID=1000

# Facultative : port HTTP sur l'hôte (127.0.0.1). Défaut : 8080.
SILLAGE_PORT=8080

# Authentification : créer le propriétaire avec compose run --rm sillage owner init.
# Aucun mot de passe n'est lu depuis ce fichier.
# SILLAGE_PUBLIC_URL=http://127.0.0.1:8080
# SILLAGE_SESSION_LIFETIME=12h
# SILLAGE_SESSION_IDLE_TIMEOUT=1h

# MCP est actif par défaut et exige une clé Bearer créée depuis le Web.
# SILLAGE_MCP_ENABLED=false désactive le transport (/mcp renvoie 404).

# Parcours déclaratif facultatif : copier les valeurs dans un .env à la racine du dépôt.
# Préparer sillage.json et son fichier de mot de passe dans ce répertoire privé.
# COMPOSE_FILE=deployments/docker/compose.yaml:deployments/docker/compose.declarative.yaml
# SILLAGE_CONFIG_DIR=/home/utilisateur/.config/sillage
# Voir docs/configuration.md ; ne placer aucun secret dans .env.
